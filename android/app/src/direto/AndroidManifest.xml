<?xml version="1.0" encoding="utf-8"?>
<!-- Só a versão direta (GitHub) instala a própria versão nova (AtualizarApp):
     a Play Store proíbe isso, e lá quem atualiza é a loja. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- o nome do Wi-Fi do celular, para dizer ao relógio qual escolher -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- a conferida de versão nova de 3 em 3 horas continua depois de religar o celular -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application>
        <!-- o app se atualiza sozinho (AtualizaSozinho.kt) -->
        <service
            android:name=".TrabalhoAtualizar"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />
        <receiver
            android:name=".StatusAutoAtualizar"
            android:exported="false" />
    </application>
</manifest>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Só leitura do que o Samsung Health, o Google Fit, o relógio e o anel
         guardam no Health Connect. A única escrita é o treino feito no app. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />

    <!-- A câmera dos óculos Ray-Ban Meta: Bluetooth com os óculos e o serviço
         que mantém a imagem chegando com o site na frente. -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- O Jarvis com a tela travada: o microfone num serviço em primeiro plano,
         e a CPU acordada para o fim do descanso chegar na hora. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
        <package android:name="com.android.chrome" />
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <!-- o reconhecimento e a voz do Android, que o serviço da tela travada usa -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- Kit da Meta em modo de desenvolvedor (ligado no app Meta AI): os dois
             valores são "0" até o app ser registrado no Wearables Developer Center. -->
        <meta-data android:name="com.meta.wearable.mwdat.APPLICATION_ID" android:value="0" />
        <meta-data android:name="com.meta.wearable.mwdat.CLIENT_TOKEN" android:value="0" />
        <meta-data android:name="com.meta.wearable.mwdat.ANALYTICS_OPT_OUT" android:value="true" />

        <!-- O 👓 do Eyes Scan chama treinolivre://oculos. Fica na MESMA tarefa do
             app (sem taskAffinity vazia): o Meta AI abre por cima para registrar e
             liberar a câmera, e a volta dele tem de cair aqui, não no treino. -->
        <activity
            android:name=".OculosActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Tema.Oculos">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="treinolivre" android:host="oculos" />
            </intent-filter>
        </activity>

        <!-- O canal de mensagens com a página (postMessage do TWA) -->
        <service
            android:name="androidx.browser.customtabs.PostMessageService"
            android:exported="true" />

        <service
            android:name=".OculosService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- O 🔒 da tela do treino chama treinolivre://bolso. Na mesma tarefa do
             app: ao sair, volta para o treino que estava aberto. -->
        <activity
            android:name=".BolsoActivity"
            android:exported="true"
            android:theme="@style/Tema.Bolso">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="treinolivre" android:host="bolso" />
            </intent-filter>
        </activity>

        <service
            android:name=".BolsoService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- O ícone. Abre o site no Chrome (os dados do navegador continuam os
             mesmos) e, se a leitura já foi permitida, leva junto o Health Connect. -->
        <activity
            android:name=".AberturaActivity"
            android:exported="true"
            android:theme="@style/Tema.Abertura">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- O botão "Sincronizar" do site chama treinolivre://saude -->
        <activity
            android:name=".SaudeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Tema.Saude">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="treinolivre" android:host="saude" />
            </intent-filter>
        </activity>

        <!-- Exigida pelo Health Connect: a política de privacidade (até o Android 13) -->
        <activity
            android:name=".PrivacidadeActivity"
            android:exported="true"
            android:theme="@style/Tema.Privacidade">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- ... e a partir do Android 14 -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE"
            android:targetActivity=".PrivacidadeActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>

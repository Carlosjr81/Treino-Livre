<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A abertura: o fundo da marca com o ícone, enquanto o Chrome sobe -->
    <style name="Tema.Abertura" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/abertura</item>
        <item name="android:statusBarColor">#0B0B0F</item>
        <item name="android:navigationBarColor">#0B0B0F</item>
    </style>
    <!-- A leitura do Health Connect: por cima do app, sem tela própria -->
    <style name="Tema.Saude" parent="@android:style/Theme.Material.Dialog.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>
    <!-- O 🔒: passa a cada ✓ do treino, e não pode aparecer -->
    <style name="Tema.Bolso" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoDisplay">false</item>
    </style>
    <!-- A tela dos óculos: tela cheia, preta, o Eyes Scan dentro do app -->
    <style name="Tema.Oculos" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
    <style name="Tema.Privacidade" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
